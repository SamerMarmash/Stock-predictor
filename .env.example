# === API Keys ===
# At least one LLM provider is required
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Market data (optional - yfinance works without keys)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key

# Social/web intelligence (optional - enables richer analysis)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
YOUTUBE_API_KEY=your-youtube-api-key
NEWS_API_KEY=your-newsapi-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# === Notification Channels ===
# Apprise URLs (see https://github.com/caronc/apprise)
# Examples:
#   Discord: discord://webhook_id/webhook_token
#   Slack:   slack://token_a/token_b/token_c
#   Email:   mailto://user:pass@gmail.com
#   Telegram: tgram://bot_token/chat_id
NOTIFICATION_URLS=

# === App Settings ===
PREDICTION_INTERVAL_MINUTES=60
DEFAULT_CONFIDENCE_THRESHOLD=60
DATABASE_URL=sqlite+aiosqlite:///./stock_predictor.db
LOG_LEVEL=INFO
